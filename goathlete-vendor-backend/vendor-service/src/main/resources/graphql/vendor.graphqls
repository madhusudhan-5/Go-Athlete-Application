type Vendor {
  id: ID!
  name: String!
  email: String!
  phone: String!
  passwordHash: String!
  businessType: String!
  verified: Boolean!
  status: String!
}

type Query {
  getAllVendors: [Vendor]
}

input VendorInput {
  name: String!
  email: String!
  phone: String!
  passwordHash: String!
  businessType: String!
  verified: Boolean!
  status: String!
}

type Mutation {
  createVendor(input: VendorInput): Vendor
}
