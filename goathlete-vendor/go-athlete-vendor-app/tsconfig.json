{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "node16",
  "module": "Node16",
    "target": "ESNext",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
  "allowImportingTsExtensions": true,
  "types": ["react", "react-native", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app",
    "components",
    "hooks",
    "services",
    "utils",
    "types",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "types/nativewind.d.ts"
  ],
  "exclude": ["node_modules"]
}