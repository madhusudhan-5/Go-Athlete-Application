[Unit]
Description=Sports Platform Django Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/sportsplatform/backend
Environment="PATH=/opt/sportsplatform/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=backend.settings"
ExecStart=/opt/sportsplatform/venv/bin/gunicorn --config gunicorn.conf.py backend.wsgi:application

Restart=always
RestartSec=10

PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
